#!/usr/bin/env ruby

ENV["RAILS_ENV"] = "test"
ENV["DATABASE_URL"] = ENV["TEST_DATABASE_URL"] if ENV["TEST_DATABASE_URL"]
if ENV["DATABASE_URL"]&.include?("_development")
  ENV["DATABASE_URL"] = ENV["DATABASE_URL"].sub(/_development(?=\?|$)/, "_test")
end

system("bin/rails", "db:prepare", exception: true)
exec("bundle", "exec", "rspec", *ARGV)
